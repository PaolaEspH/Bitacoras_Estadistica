cat("Variable:", var, "\n")
cat("N:", length(df_num[[var]]), "\n")
cat("Media:", mean(df_num[[var]], na.rm = TRUE), "\n")
cat("Desviación estándar:", sd(df_num[[var]], na.rm = TRUE), "\n")
